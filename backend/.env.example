# Kubernetes Investigation Settings
KUBECONFIG_PATH=
KUBERNETES_CONTEXT=
KUBEVORA_DEFAULT_NAMESPACE=default
KUBEVORA_COMMAND_TIMEOUT=15
KUBEVORA_LOG_TAIL=100
KUBEVORA_STUCK_THRESHOLD_SECONDS=300

# AI Configuration (Gemini API - Future Phase)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Database Configuration (Future Phase)
DATABASE_URL=sqlite:///./kubevora.db
